{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]    
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=medconnect;Username=postgres;Password=postgres"
  },
  "Seed": {
    "Specializations": true,
    "DemoUsers": false
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/medconnect",
    "Audience": "medconnect-app",
    "AdminApiUrl": "http://localhost:8080",
    "AdminClientId": "medconnect-admin-cli",
    "AdminClientSecret": "",
    "Realm": "medconnect"
  }
}
