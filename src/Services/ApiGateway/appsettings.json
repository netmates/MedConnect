{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "ReverseProxy": {
    "Routes": {
      "chats": {
        "ClusterId": "communication",
        "Order": 0,
        "Match": {
          "Path": "/api/chats/{**catch-all}"
        }
      },
      "appointments": {
        "ClusterId": "appointment",
        "Order": 1,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "communication": {
        "HttpRequest": {
          "ActivityTimeout": "01:00:00"
        },
        "Destinations": {
          "local": {
            "Address": "http://localhost:5080/"
          }
        }
      },
      "appointment": {
        "Destinations": {
          "local": {
            "Address": "http://localhost:5067/"
          }
        }
      }
    }
  }
}
